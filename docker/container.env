# Environment for the engine image under Docker Compose (docker-compose.yml) or
# `docker run` by hand, with this repository's serve.sh mounted as the entry
# point (see README.md in this folder). serve.sh turns these into the same
# settings and flags as ./start.sh's container, so every other setting in
# ../.env.example and ../.env.advanced.example can be added here too.
# ./start.sh does not read this file: it writes the same thing from .env.
# Format: KEY=value, one per line, no quotes, no notes after a value.
#
# One layout: tp2 (tensor-parallel 2, whole routed experts per card).
LAYOUT=tp2
# The two cards, as nvidia-smi numbers them (the container sees every card).
CUDA_VISIBLE_DEVICES=0,1
#
# Peer access is content-verified before use.
# off disables all peer transports; force bypasses verification.
P2P=auto
#
# Paths inside the container. Leave these as they are; the host directories
# are mounted onto them by the docker run command or docker-compose.yml.
VENV=/opt/venv
MODEL=/models/Qwen3.8-Flash-Next-exl3
CUDA_HOME=/usr/local/cuda
HOST=0.0.0.0
PORT=8000
#
# Caches. The server runs as you, not root (`docker run --user`, or Compose's
# switch to the checkout's owner), so everything it writes lands in the
# mounted cache directory, owned by you.
PYTHONDONTWRITEBYTECODE=1
RECIPE_CACHE_ROOT=/cache
TMPDIR=/cache/tmp
HOME=/cache
USER=recipe
LOGNAME=recipe
XDG_CACHE_HOME=/cache/.cache
HF_HOME=/cache/huggingface
FLASHINFER_WORKSPACE_BASE=/cache
TORCHINDUCTOR_CACHE_DIR=/cache/torchinductor
TRITON_CACHE_DIR=/cache/.triton/cache
TORCH_EXTENSIONS_DIR=/cache/.cache/torch_extensions
VLLM_CUSTOM_ALLREDUCE_FLAGS_BUILD_DIR=/cache/.cache/vllm/custom_all_reduce_flags
VLLM_CACHE_ROOT=/cache/.cache/vllm
TILELANG_CACHE_DIR=/cache/.tilelang/cache
TILELANG_TMP_DIR=/cache/.tilelang/cache/tmp
CUDA_CACHE_PATH=/cache/.nv/ComputeCache
# Opt-in device-specific compilation cache seed; 0 keeps normal cache paths.
VLLM_IMAGE_CACHE_SEED=0
